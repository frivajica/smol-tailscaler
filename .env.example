# Copy to .env and fill in your values.
# These are embedded into the binary at build time.
# NOTE: embedded values can be extracted with `strings setup.exe` - never share the binary.

# Tailscale auth key (required) — or pass via ./build.sh -authkey "..."
TS_AUTH_KEY=tskey-auth-kXXXXX-XXXXXXXXXXXXXXXX

# Temp user password (optional) — or pass via ./build.sh -password "..."
USER_PASSWORD=YourTempPassword123

# Admin user to create (optional, default: admin) — or pass via ./build.sh -user "..."
USER_NAME=admin

# Code signing (automatic) — build.sh generates signing/signing.pfx on first
# build and signs every build. Override with -signcert/-signpass, or:
# SIGN_CERT=signing/signing.pfx
# SIGN_PASSWORD=changeme
# SIGN_TIMESTAMP_URL=http://timestamp.digicert.com
